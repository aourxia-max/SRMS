MYSQL_DATABASE=srms_docker
MYSQL_USER=srms_docker
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
# The three port variables below are only used by the local Docker development stack.
# The production Compose override removes these public port mappings.
MYSQL_PORT=13306
API_PORT=13000
WEB_PORT=15173
JWT_ACCESS_SECRET=replace_with_a_unique_32_character_or_longer_secret
JWT_REFRESH_SECRET=replace_with_a_different_unique_32_character_or_longer_secret
TENANT_ID_ENCRYPTION_KEY=base64_encoded_32_byte_key
TENANT_ID_HMAC_SECRET=replace_with_a_unique_32_character_or_longer_secret
TENANT_FILE_MAX_SIZE_BYTES=10485760
TENANT_FILE_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/heic
INITIAL_SUPER_ADMIN_USERNAME=
INITIAL_SUPER_ADMIN_DISPLAY_NAME=
INITIAL_SUPER_ADMIN_PASSWORD=
